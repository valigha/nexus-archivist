# Copy to /app/config/.env or set these on the container.
# Container environment variables win over this file.

# Empty = sit on the dashboard until you set a query or add a link.
HN_TAGS=
SLEEP_INTERVAL=3600

LIBRARY_PATH=/app/library/
LIBRARY_SPLIT=10000
DOWNLOADME_FILEPATH=/app/config/downloadme.txt
DONTDOWNLOADME_FILEPATH=/app/config/dontdownloadme.txt

REQUEST_DELAY_MS=1500
ZIP_TIMEOUT_SEC=900
# USER_AGENT=

CATCH_UP_STREAK=40
MAX_PER_CYCLE=10
CLEANUP_TEMPORARY_FILES=true
DRY_RUN=false
RUN_ONCE=false
STATUS_PORT=8100
# LIBRARY_IMPORT_KEY=

PUID=99
PGID=100
UMASK=002
TZ=America/New_York
FILE_PREFIX=HN
